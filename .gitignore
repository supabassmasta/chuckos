# editor swap files
*.swp

# vendored live-build checkout (see vendor-live-build.sh) -- a third-party
# git clone, not ours to track
/.live-build/

# live-build's own top-level scaffolding / build state -- all regenerated
# by `lb config` / `lb build`, never hand-edited, never tracked.
# IMPORTANT: these are all anchored to the repo root (leading /) -- without
# that, e.g. a bare "local/" also matches config/includes.chroot/usr/local/
# (our own image's filesystem layout), silently swallowing anything placed
# there. Caught this once already: chuckos-power never got tracked because
# of exactly this.
/.build/
/chroot/
/cache/
/local/
/auto/
/binary/

# build outputs
/*.iso
/*.img
/*.zsync
/*.contents
/*.files
/*.packages
/*.buildlog

# vm-test.sh's scratch install disk
/chuckos-test-disk.qcow2

# live-build regenerates a bunch of its own internal scaffolding directly
# under config/ on every `lb config` run (config/bootstrap, config/binary,
# config/chroot_apt, config/packages, config/preseed, config/templates,
# etc. -- the exact set has grown across live-build versions and isn't
# worth enumerating). Instead: ignore everything under config/ by default,
# and explicitly re-include only the subdirectories we actually author by
# hand. Add a new "!config/<dir>/" line here if a new authored subdir is
# ever added.
config/*
!config/package-lists/
!config/includes.chroot/
!config/hooks/
!config/archives/
!config/bootloaders/

# ChucK source gets rsync'd into the image at build time from
# ../chuck-1.5.5.8 -- no need to duplicate it inside this repo too
config/includes.chroot/usr/local/src/
